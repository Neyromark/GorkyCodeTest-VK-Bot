# Скопируйте в .env: cp .env.example .env

# Токен сообщества ВК с доступом к сообщениям (Long Poll + messages.send)
VK_TOKEN=your_vk_group_token_here

# Куда бот пересылает сообщения пользователей (POST /api/v1/get-message).
# В docker compose это контейнер backend:
HOST=backend
PORT=8000
# Для локального запуска без Docker замените HOST на localhost

# Озвучка ответов (Silero TTS): голос из набора aidar, baya, kseniya, xenia, eugene
TTS_SPEAKER=baya
# Русская модель Silero. Другая модель скачается при первом голосовом ответе,
# в образе по умолчанию уже зашита v5_6_ru
TTS_MODEL=v5_6_ru
